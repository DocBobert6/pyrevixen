+package org.mozilla.fenix.pyrevixen
+
+import android.content.Context
+import androidx.preference.PreferenceManager
+import mozilla.components.concept.engine.EngineSession
+import mozilla.components.concept.engine.webextension.MessageHandler
+import mozilla.components.concept.engine.webextension.WebExtensionRuntime
+import mozilla.components.support.webextensions.BuiltInWebExtensionController
+import org.json.JSONObject
+
+/**
+ * PyreVixen video toolkit: installs the bundled WebExtension that carries the
+ * page-side transform logic and owns the native <-> page message bridge.
+ * Follows the ReaderViewFeature / WebCompatFeature built-in-extension pattern
+ * (BuiltInWebExtensionController + resource://android assets URL).
+ */
+internal const val VIDEO_TOOLKIT_EXTENSION_ID = "pyrevixen-video-toolkit@pyrevixen.browser"
+internal const val VIDEO_TOOLKIT_EXTENSION_URL = "resource://android/assets/extensions/video-toolkit/"
+internal const val VIDEO_TOOLKIT_CONTENT_PORT = "pyrevixenVideoToolkit"
+
+class VideoToolkitFeature(
+    private val context: Context,
+) {
+    private val extensionController = BuiltInWebExtensionController(
+        VIDEO_TOOLKIT_EXTENSION_ID,
+        VIDEO_TOOLKIT_EXTENSION_URL,
+        VIDEO_TOOLKIT_CONTENT_PORT,
+    )
+
+    /** Installs the bundled extension. Called once at engine startup. */
+    fun install(runtime: WebExtensionRuntime) {
+        if (!isEnabled()) return
+        extensionController.install(runtime)
+    }
+
+    /**
+     * Wires the content message handler for one tab's engine session.
+     * Call for the selected tab (and on tab switch / new engine session),
+     * mirroring ReaderViewFeature.connectReaderViewContentScript.
+     */
+    fun registerSession(engineSession: EngineSession, handler: MessageHandler) {
+        extensionController.registerContentMessageHandler(
+            engineSession,
+            handler,
+            VIDEO_TOOLKIT_CONTENT_PORT,
+        )
+    }
+
+    /** Native -> page. Guarded exactly like ReaderViewFeature.checkReaderState. */
+    fun send(engineSession: EngineSession?, msg: JSONObject) {
+        if (engineSession == null) return
+        if (extensionController.portConnected(engineSession, VIDEO_TOOLKIT_CONTENT_PORT)) {
+            extensionController.sendContentMessage(msg, engineSession, VIDEO_TOOLKIT_CONTENT_PORT)
+        }
+    }
+
+    private fun isEnabled(): Boolean =
+        PreferenceManager.getDefaultSharedPreferences(context)
+            .getBoolean("pyrevixen.video.toolkit.enabled", true)
+}
