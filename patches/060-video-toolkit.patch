+package org.mozilla.fenix.pyrevixen
+
+import android.content.Context
+import android.view.GestureDetector
+import android.view.MotionEvent
+import android.view.ScaleGestureDetector
+import android.view.ViewGroup
+
+/**
+ * Transparent overlay placed above the engine view for the PyreVixen video
+ * toolkit. It never consumes a touch until the gesture is classified as a
+ * toolkit gesture -- everything else falls through to GeckoView untouched.
+ *
+ * Contract (full protocol in video-toolkit/IN_APP_DESIGN.md):
+ * - pinch (second pointer down inside a managed video rect) -> page bridge
+ * - single-finger drag past touch slop inside a zoomed (>1x) video rect -> pan
+ * - double-tap on a managed video -> zoom toggle
+ *
+ * Exact detector plumbing and the inbound message wiring are fitted against
+ * the real MessageHandler signature at build time.
+ */
+class VideoGestureOverlay(context: Context) : ViewGroup(context) {
+
+    private val scaleDetector = ScaleGestureDetector(context, ScaleListener())
+    private val gestureDetector = GestureDetector(context, GestureListener())
+
+    init {
+        isClickable = false
+        isFocusable = false
+    }
+
+    override fun onInterceptTouchEvent(event: MotionEvent): Boolean {
+        // Intercept only once a gesture classifies as a toolkit gesture;
+        // classification logic is fitted at build time. Until then the
+        // overlay is behaviourally invisible.
+        return false
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        scaleDetector.onTouchEvent(event)
+        gestureDetector.onTouchEvent(event)
+        return true
+    }
+
+    /** Called by the hosting fragment on HTML5 fullscreen enter/exit. */
+    fun onFullscreenChanged(inFullscreen: Boolean) {
+        // Enter: dismiss any open toolkit bottom sheet (immersive = no chrome).
+        // Exit: layout changed under us; re-sync page state over the bridge.
+        // Wired to the page bridge at build time.
+    }
+
+    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
+        // No children to lay out; the overlay draws nothing itself.
+    }
+
+    private inner class ScaleListener : ScaleGestureDetector.SimpleOnScaleGestureListener() {
+        override fun onScale(detector: ScaleGestureDetector): Boolean {
+            // Forward pinch phase/scale/focal-point to the page bridge.
+            return true
+        }
+    }
+
+    private inner class GestureListener : GestureDetector.SimpleOnGestureListener() {
+        override fun onDoubleTap(event: MotionEvent): Boolean {
+            // Forward double-tap to the page bridge.
+            return true
+        }
+    }
+}
