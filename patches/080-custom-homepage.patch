 ) {
     /**
      * Loads a URL or performs a search depending on the value of [searchTermOrURL].
@@ -118,7 +121,28 @@ class FenixBrowserUseCases(
     }
 
     /**
-     * Adds a new homepage ("about:home") tab.
+     * Resolves the user-selected PyreVixen homepage URL.
+     *
+     * @return "about:blank" for the blank mode, the custom URL for the custom
+     * mode (falling back to about:home when empty), or about:home otherwise.
+     */
+    fun resolveHomepageUrl(): String {
+        return when (settings?.homepageMode) {
+            "blank" -> "about:blank"
+            "custom" -> {
+                val raw = settings.homepageCustomUrl.trim()
+                when {
+                    raw.isEmpty() -> ABOUT_HOME_URL
+                    "://" in raw -> raw
+                    else -> "https://$raw"
+                }
+            }
+            else -> ABOUT_HOME_URL
+        }
+    }
+
+    /**
+     * Adds a new homepage tab (PyreVixen: the user-selected homepage URL).
      *
      * @param private Whether or not the new homepage tab should be private.
      * @param startLoading Whether the new tab should start loading immediately.
@@ -131,7 +155,7 @@ class FenixBrowserUseCases(
         selectTab: Boolean = true,
     ): String {
         return tabsUseCases.addTab.invoke(
-            url = ABOUT_HOME_URL,
+            url = resolveHomepageUrl(),
             title = homepageTitle,
             selectTab = selectTab,
             startLoading = startLoading,
@@ -139,8 +163,8 @@ class FenixBrowserUseCases(
         )
     }
 
-    /** Loads the homepage ("about:home"). */
+    /** Loads the homepage (PyreVixen: the user-selected homepage URL). */
     fun navigateToHomepage() {
-        loadUrlUseCase.invoke(url = ABOUT_HOME_URL)
+        loadUrlUseCase.invoke(url = resolveHomepageUrl())
     }
 }
