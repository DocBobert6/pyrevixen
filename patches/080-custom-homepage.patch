         )
 
+    /**
+     * PyreVixen homepage mode: "default" (the home screen), "blank"
+     * (about:blank), or "custom" ([homepageCustomUrl]).
+     */
+    var homepageMode: String by
+        stringPreference(
+            key = appContext.getPreferenceKey(R.string.pref_key_homepage_mode),
+            default = { "default" },
+            persistDefaultIfNotExists = true,
+        )
+
+    /**
+     * PyreVixen custom homepage URL, used when [homepageMode] is "custom".
+     * Normalized by the settings UI: "https://" is prepended when the stored
+     * value has no scheme. Empty means fall back to the default home screen.
+     */
+    var homepageCustomUrl: String by
+        stringPreference(
+            key = appContext.getPreferenceKey(R.string.pref_key_homepage_custom_url),
+            default = { "" },
+            persistDefaultIfNotExists = true,
+        )
+
     /**
      * Indicates if the user has selected the option to never start on the home screen and have their last tab opened.
      */
