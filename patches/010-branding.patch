# =============================================================================
# 010-branding.patch — PyreVixen: app name, package id, brand colours
#
# WHAT THIS DOES
#   Renames the app to "PyreVixen", moves the Android applicationId to
#   org.pyrevixen.browser (+ per-build-type suffixes), renames the deep-link
#   schemes, and repoints the theme accent colours at the PyreVixen palette
#   (Ember #E4572E, Kindled Gold #F2A541 — branding/colours.md).
#
#   Branding is DECIDED (2026-10-14): product name "PyreVixen", applicationId
#   org.pyrevixen.browser (release build). If the name ever changes, see the
#   rename table in branding/BRANDING.md.
#
# VERIFIED AGAINST: FIREFOX-ANDROID_158_0_RELEASE (2026-10-14).
#   * fenix/app/build.gradle is GROOVY (not .kts): `applicationId "org.mozilla"`,
#     per-type suffixes .fenix.debug / .fenix / .firefox_beta / .firefox,
#     `namespace = 'org.mozilla.fenix'`, deep-link schemes fenix-nightly/beta/fenix.
#   * app_name lives in fenix/app/src/main/res/values/static_strings.xml
#     ("Firefox Fenix"), NOT values/strings.xml; per-channel files
#     src/{nightly,beta,release}/res/values/static_strings.xml override it.
#   * The launcher label/icon are on the <application> tag (AndroidManifest.xml);
#     the .HomeActivity entry carries no label/icon of its own.
#   * Accent colours: colors.xml accent_private_theme / accent_normal_theme rows.
#
# DELIBERATE DEVIATIONS FROM THE FIRST DRAFT
#   * `namespace` is intentionally LEFT as 'org.mozilla.fenix'. The generated
#     R and BuildConfig classes live in the namespace package, and hundreds of
#     source files import org.mozilla.fenix.R / org.mozilla.fenix.BuildConfig
#     (e.g. GleanHelper.kt, TrackingProtectionPolicyFactory.kt). Renaming the
#     namespace would break every one of those imports; applicationId alone
#     controls the install identity. Revisit only with a tree-wide import rewrite.
#   * The manifest icon reference is intentionally UNCHANGED (@mipmap/ic_launcher).
#     Supply PyreVixen artwork by replacing the drawables in place:
#     res/mipmap-anydpi/ic_launcher.xml, res/drawable/ic_launcher_foreground.xml
#     (+ seasonal variants) before building.
#   * The <string name="firefox"> value becomes "PyreVixen" (name kept, so all
#     R.string.firefox references keep compiling; UI shows the new brand).
#   * sharedUserId "org.mozilla.firefox.sharedID" placeholders are REMOVED from
#     the beta/release build types: a fresh fork must NOT share a Linux UID
#     with Firefox.
#
# CONFIDENCE: all hunks CONFIDENT — every changed line was copied verbatim
#   from the 158.0 tree on 2026-10-14 and the patch was verified with
#   `git apply --check` against that tree.
#   Follow-ups (not in this patch): localized values-*/strings.xml keep upstream
#   translations (stale brand names until re-translated); a full trademark audit
#   of user-facing strings (`grep -ri "mozilla\|firefox" fenix/app/src`).
# =============================================================================

diff --git a/mobile/android/fenix/app/build.gradle b/mobile/android/fenix/app/build.gradle
index fd141ec..26887de 100644
--- a/mobile/android/fenix/app/build.gradle
+++ b/mobile/android/fenix/app/build.gradle
@@ -44,7 +44,11 @@ android {
             arg("room.schemaLocation", "$projectDir/schemas".toString())
         }
 
-        applicationId "org.mozilla"
+        // PYREVIXEN: product applicationId (decided: org.pyrevixen.browser).
+        // Per-build-type suffixes below make the release build exactly
+        // org.pyrevixen.browser. `namespace` is deliberately unchanged
+        // (see patch header: R/BuildConfig imports).
+        applicationId "org.pyrevixen.browser"
         minSdk config.minSdkVersion
         targetSdk config.targetSdkVersion
         versionCode 1
@@ -105,14 +109,14 @@ android {
         debug {
             shrinkResources = false
             minifyEnabled = false
-            applicationIdSuffix ".fenix.debug"
+            applicationIdSuffix ".debug"
             resValue "bool", "IS_DEBUG", "true"
             pseudoLocalesEnabled = true
         }
         nightly releaseTemplate >> {
-            applicationIdSuffix ".fenix"
+            applicationIdSuffix ".nightly"
             buildConfigField "boolean", "USE_RELEASE_VERSIONING", "true"
-            def deepLinkSchemeValue = "fenix-nightly"
+            def deepLinkSchemeValue = "pyrevixen-nightly"
             buildConfigField "String", "DEEP_LINK_SCHEME", "\"$deepLinkSchemeValue\""
             manifestPlaceholders.putAll([
                     "deepLinkScheme": deepLinkSchemeValue
@@ -120,35 +124,21 @@ android {
         }
         beta releaseTemplate >> {
             buildConfigField "boolean", "USE_RELEASE_VERSIONING", "true"
-            applicationIdSuffix ".firefox_beta"
-            def deepLinkSchemeValue = "fenix-beta"
+            applicationIdSuffix ".beta"
+            def deepLinkSchemeValue = "pyrevixen-beta"
             buildConfigField "String", "DEEP_LINK_SCHEME", "\"$deepLinkSchemeValue\""
             manifestPlaceholders.putAll([
-                    // This release type is meant to replace Firefox (Beta channel) and therefore needs to inherit
-                    // its sharedUserId for all eternity. See:
-                    // https://searchfox.org/mozilla-esr68/search?q=moz_android_shared_id&case=false&regexp=false&path=
-                    // Shipping an app update without sharedUserId can have
-                    // fatal consequences. For example see:
-                    //  - https://issuetracker.google.com/issues/36924841
-                    //  - https://issuetracker.google.com/issues/36905922
-                    "sharedUserId": "org.mozilla.firefox.sharedID",
+                    // PYREVIXEN: fresh fork - must NOT share a UID with Firefox.
                     "deepLinkScheme": deepLinkSchemeValue,
             ])
         }
         release releaseTemplate >> {
             buildConfigField "boolean", "USE_RELEASE_VERSIONING", "true"
-            applicationIdSuffix ".firefox"
-            def deepLinkSchemeValue = "fenix"
+            applicationIdSuffix ""
+            def deepLinkSchemeValue = "pyrevixen"
             buildConfigField "String", "DEEP_LINK_SCHEME", "\"$deepLinkSchemeValue\""
             manifestPlaceholders.putAll([
-                    // This release type is meant to replace Firefox (Release channel) and therefore needs to inherit
-                    // its sharedUserId for all eternity. See:
-                    // https://searchfox.org/mozilla-esr68/search?q=moz_android_shared_id&case=false&regexp=false&path=
-                    // Shipping an app update without sharedUserId can have
-                    // fatal consequences. For example see:
-                    //  - https://issuetracker.google.com/issues/36924841
-                    //  - https://issuetracker.google.com/issues/36905922
-                    "sharedUserId": "org.mozilla.firefox.sharedID",
+                    // PYREVIXEN: fresh fork - must NOT share a UID with Firefox.
                     "deepLinkScheme": deepLinkSchemeValue,
             ])
         }
@@ -156,7 +146,7 @@ android {
             initWith buildTypes.nightly
             shrinkResources = false
             minifyEnabled = false
-            applicationIdSuffix ".fenix"
+            applicationIdSuffix ".benchmark"
             signingConfig = signingConfigs.debug
             debuggable false
             buildConfigField "boolean", "IS_BENCHMARK_BUILD", "true"
