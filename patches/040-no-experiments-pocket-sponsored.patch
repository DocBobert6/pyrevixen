-        buildConfigField 'String', 'NIMBUS_ENDPOINT', 'null'
-    }
+    // PYREVIXEN: Nimbus never gets a remote endpoint (no experiments).
+    buildConfigField 'String', 'NIMBUS_ENDPOINT', 'null'
 
@@ -395,8 +391,4 @@ android.buildTypes.debug.with {
 
